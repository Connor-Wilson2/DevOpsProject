<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="380.0" minWidth="540.0" prefHeight="560.0" prefWidth="820.0"
            style="-fx-background-color: #f1f2ed;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.westga.comp4420.Collectionbuilder.view.codebehind.FactionListWindow">
   <top>
      <VBox spacing="7.0" style="-fx-background-color: #26352f;">
         <padding>
            <Insets top="20.0" right="26.0" bottom="18.0" left="26.0" />
         </padding>
         <Label text="FACTION LIST" textFill="#d2a36b">
            <font>
               <Font name="System Bold" size="12.0" />
            </font>
         </Label>
         <Label fx:id="listTitle" text="List title" textFill="WHITE">
            <font>
               <Font name="System Bold" size="25.0" />
            </font>
         </Label>
         <Label fx:id="listDetails" text="Faction / subfaction" textFill="#dce2dc" />
      </VBox>
   </top>
   <center>
      <VBox spacing="10.0">
         <padding>
            <Insets top="20.0" right="26.0" bottom="12.0" left="26.0" />
         </padding>
         <Label text="UNITS" textFill="#52645b">
            <font>
               <Font name="System Bold" size="12.0" />
            </font>
         </Label>
         <ListView fx:id="units" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: white; -fx-border-color: #d7dbd4; -fx-border-radius: 3;" />
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <padding>
            <Insets top="8.0" right="26.0" bottom="20.0" left="26.0" />
         </padding>
         <Label fx:id="pointsTotal" text="Total: 0 points" textFill="#26352f">
            <font>
               <Font name="System Bold" size="16.0" />
            </font>
         </Label>
         <Region HBox.hgrow="ALWAYS" />
         <Button fx:id="deleteUnitButton" mnemonicParsing="false" onAction="#deleteUnit"
                 text="Delete unit" style="-fx-background-color: #e1e4df; -fx-text-fill: #26352f;" />
         <Button mnemonicParsing="false" onAction="#addUnit" text="Add unit"
                 style="-fx-background-color: #a45135; -fx-text-fill: white; -fx-font-weight: bold;" />
      </HBox>
   </bottom>
</BorderPane>